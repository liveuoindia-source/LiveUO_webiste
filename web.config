<?xml version="1.0" encoding="UTF-8"?>
<!--
  LiVEUO - IIS configuration for the static marketing site.

  PLATFORM NOTE: production is IIS on Plesk for Windows, behind Cloudflare -
  NOT Apache. The SEO redirect block was specified as .htaccess rules; this
  file is the translation. Rule numbering below matches the original block.

  STATUS: as of 25 Aug 2026 IIS is not reading this file - every section was
  verified inert on the live site (requestFiltering did not block
  /package.json, httpErrors did not serve the branded 404, no rewrite fired).
  Neither requestFiltering nor httpErrors needs an add-on module, and a
  malformed file would raise HTTP 500 rather than be ignored, so the cause is
  placement or an IIS override lock, not syntax. Until that is resolved the
  redirects are served from Cloudflare Redirect Rules instead.

  Requires the IIS URL Rewrite module (standard on Plesk Windows).
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!--
          1. Canonical host - force https://www.liveuo.com.
             Both hosts currently answer 200, so Googlebot crawls the site
             twice and splits crawl budget across them.

             The scheme test matches X-Forwarded-Proto positively (= http)
             rather than negating https: Cloudflare always sets that header,
             so a missing header means a direct-to-origin request and is left
             alone. This cannot loop under Cloudflare Flexible SSL, which a
             naive "if not https, redirect" rule would.
        -->
        <rule name="Canonical host and scheme" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^www\.liveuo\.com$" negate="true" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^http$" />
          </conditions>
          <action type="Redirect" url="https://www.liveuo.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!--
          2. Spam / injected doorway URLs -> 410 Gone.
             410 tells Google "permanently gone, stop asking"; 404 means
             "try again later". These must precede the trailing-slash rule
             below, or a slash-less spam path is redirected before it is
             killed.

             Devanagari is matched both decoded and percent-encoded: U+0900
             to U+097F encode to UTF-8 bytes E0 A4 xx / E0 A5 xx.
        -->
        <rule name="Spam doorway - Devanagari" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{URL}" pattern="[ऀ-ॿ]" />
            <add input="{REQUEST_URI}" pattern="%E0%A[45]" />
          </conditions>
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="Gone" />
        </rule>

        <!-- ignoreCase="false" is required: [A-Z0-9] must stay uppercase-only,
             or ordinary five-letter paths would be caught. -->
        <rule name="Spam doorway - code pairs" stopProcessing="true">
          <match url="^[A-Z0-9]{5}/[A-Z0-9]{5}/?$" ignoreCase="false" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="Gone" />
        </rule>

        <rule name="Spam doorway - domain suffix" stopProcessing="true">
          <match url="/liveuo\.com/?$" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="Gone" />
        </rule>

        <!--
          3. Phone-number paths -> 410.
             NARROWED from the original spec. The original matched any path
             containing an 11-digit number starting with 91, which is broader
             than needed and would catch a future blog slug or ticket id
             containing such a run of digits. Only one number was ever
             crawled, so only that number is matched.
        -->
        <rule name="Spam doorway - phone path" stopProcessing="true">
          <match url="\+?918050718269" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="Gone" />
        </rule>

        <!--
          4. Legacy paths from the previous site -> 301.
             /services/ was specified to point at /products/, but /products/
             has no index page and answers 403, so that would redirect into a
             dead end. Pointed at the homepage instead - see the summary.
        -->
        <rule name="Legacy home" stopProcessing="true">
          <match url="^home/?$" />
          <action type="Redirect" url="https://www.liveuo.com/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy about-us" stopProcessing="true">
          <match url="^about-us/?$" />
          <action type="Redirect" url="https://www.liveuo.com/about/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy contact-us" stopProcessing="true">
          <match url="^contact-us/?$" />
          <action type="Redirect" url="https://www.liveuo.com/contact/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy services index" stopProcessing="true">
          <match url="^services/?$" />
          <action type="Redirect" url="https://www.liveuo.com/" redirectType="Permanent" />
        </rule>

        <!-- Legacy URL structure -> current IA (pre-existing set). -->
        <rule name="Legacy case-studies" stopProcessing="true">
          <match url="^case-studies/?$" />
          <action type="Redirect" url="https://www.liveuo.com/resources/case-studies/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy services/ecommerce" stopProcessing="true">
          <match url="^services/ecommerce/?$" />
          <action type="Redirect" url="https://www.liveuo.com/products/ecommerce-platform/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy services/pharma" stopProcessing="true">
          <match url="^services/pharma/?$" />
          <action type="Redirect" url="https://www.liveuo.com/products/pharcare/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy services/custom" stopProcessing="true">
          <match url="^services/custom/?$" />
          <action type="Redirect" url="https://www.liveuo.com/products/custom-application-development/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy services/automation" stopProcessing="true">
          <match url="^services/automation/?$" />
          <action type="Redirect" url="https://www.liveuo.com/products/custom-application-development/" redirectType="Permanent" />
        </rule>

        <!-- Next.js export artifacts: served as-is these answer 200 with
             error-page content, which Google files as a soft 404. -->
        <rule name="Error-page artifacts answer 404" stopProcessing="true">
          <match url="^(404|_not-found)/?$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!--
          5. Enforce trailing slash - one URL per page.
             Skips real files and real directories (IIS already 301s a
             directory to its slashed form) and anything with an extension.
             The extension test uses "dot in the final segment" rather than a
             {2,4} length bound, which is equivalent here and avoids brace
             syntax in the pattern.
        -->
        <rule name="Enforce trailing slash" stopProcessing="true">
          <match url="(.*[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="\.[^/]+$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.liveuo.com/{R:1}/" redirectType="Permanent" />
        </rule>

      </rules>

      <!-- Keep Next.js RSC payloads out of the index: each .txt carries the
           full text of the page it belongs to, so an indexed one duplicates
           the real page. Header-only rewrite, so the gzip restriction on
           outbound content rules does not apply. -->
      <outboundRules>
        <preConditions>
          <preCondition name="IsRscPayload">
            <add input="{REQUEST_URI}" pattern="(^|/)(index|__next\..+)\.txt$" />
          </preCondition>
        </preConditions>
        <rule name="Noindex RSC payloads" preCondition="IsRscPayload">
          <match serverVariable="RESPONSE_X_Robots_Tag" pattern=".*" />
          <action type="Rewrite" value="noindex" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Real 404s render the site's own error page. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Files that must not be reachable over HTTP. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="server" />
          <add segment="node_modules" />
          <add segment="data" />
          <add segment="docs" />
          <add segment="scripts" />
          <add segment=".claude" />
          <add segment="server.js" />
          <add segment="package.json" />
          <add segment="package-lock.json" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".zip" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".db-wal" allowed="false" />
          <add fileExtension=".db-shm" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
