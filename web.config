<?xml version="1.0" encoding="UTF-8"?>
<!--
  LiVEUO - IIS + iisnode configuration.

  WHY THIS FILE IS TRACKED AGAIN
  ==============================
  Plesk writes a web.config containing the iisnode handler when Node.js is
  enabled on the domain. But Plesk's git deployment SYNCS the working tree, so
  a repo that does not contain web.config causes that file to be deleted on
  every deploy - silently unwiring the Node app while the panel still reports
  "Node.js was enabled on liveuo.com". Enabling Node then appears to do
  nothing at all, which is exactly the loop this project was stuck in.

  Shipping the handler here inverts that: a deploy now reinforces the
  configuration instead of deleting it.

  BLAST RADIUS
  ============
  The rewrite deliberately lets IIS serve real files directly and sends only
  non-file requests to Node. Routing everything through Node would let the
  deny-list in server.js police static paths too, but it also means a Node
  process that fails to boot takes the whole marketing site down - which is
  what happened on 2 Sep. The requestFiltering block below reproduces that
  protection at the IIS layer, so the sensitive paths are covered whichever
  layer answers.

  NODE PATH
  =========
  nodeProcessCommandLine must name a real node.exe. When it does not, iisnode
  answers 500.1002 with HRESULT 0x2 - the Windows code for
  ERROR_FILE_NOT_FOUND. The path below comes from the host's own npm stack
  trace, which ran out of C:\Program Files\nodejs\node_modules\npm, so
  node.exe sits beside it. If iisnode still reports 0x2, correct this line
  first - nothing else in this file matters until the process can start.
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      loggingEnabled="true"
      logDirectory="iisnode-logs"
      devErrorsEnabled="true"
      nodeProcessCountPerApplication="1" />

    <rewrite>
      <rules>
        <!-- iisnode's own debug endpoint, left alone. -->
        <rule name="iisnode-debug" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- A real file on disk is served by IIS directly. This is the rule
             that keeps the static site alive even when Node will not start. -->
        <rule name="static-files" stopProcessing="true">
          <match url="." ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Everything else - /viewer/..., /api/..., /admin/... - is the app. -->
        <rule name="app-routes">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Static files bypass Node under the rule above, so the deny-list in
      server.js never sees them. These entries reproduce it at the IIS layer:
      application source, the database, uploads and the gated documents stay
      unreachable regardless of which layer serves the request.
    -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="server" />
          <add segment="node_modules" />
          <add segment="data" />
          <add segment="uploads" />
          <add segment="scripts" />
          <add segment="content" />
          <add segment="docs" />
          <add segment="iisnode-logs" />
          <add segment=".git" />
          <add segment=".github" />
          <add segment=".claude" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".zip" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".db-wal" allowed="false" />
          <add fileExtension=".db-shm" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Detailed while bringing Node up. Switch to errorMode="Custom" once the
         app is confirmed healthy - detailed errors expose stack traces. -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

  </system.webServer>
</configuration>
