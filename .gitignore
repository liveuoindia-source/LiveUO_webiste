node_modules/
.env
data/
uploads/

# Secure document viewer: the PDFs themselves, the client email allow-list,
# and the access log. None of it belongs in a public repo.
server/private/

# Server configuration, owned by Plesk/IIS - NOT by this repo.
# Plesk writes its own web.config containing the iisnode handler when
# Node.js is enabled. Tracking this file meant every git pull overwrote
# that handler and silently unwired the Node app. Template kept as
# web.config.iisnode, applied by hand.
web.config

# Demo videos: large binary HLS output, uploaded to the server directly.
# Never through git - it would bloat the repo and every Plesk pull with it.
demos/media/
demos-src/
