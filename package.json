{
  "name": "liveuo-website",
  "version": "1.0.0",
  "private": true,
  "description": "LiVEUO — static marketing site plus an Express/SQLite Downloads Manager backend.",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/build.js && node scripts/check-placeholders.js",
    "check": "node scripts/build.js --check && node scripts/check-placeholders.js && node scripts/check-blog.js",
    "test": "npm run check",
    "blog:check": "node scripts/check-blog.js",
    "blog:next": "node scripts/publish-daily-post.js --dry-run",
    "blog:publish": "node scripts/publish-daily-post.js",
    "blog:regen": "node scripts/publish-daily-post.js --regenerate",
    "blog:ping": "node scripts/ping-indexers.js",
    "doctor": "node scripts/doctor.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
