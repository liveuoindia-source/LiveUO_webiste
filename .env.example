# Copy this file to .env and fill in real values. Never commit .env.

# Session
SESSION_SECRET=

# First-run admin account for the Downloads Manager (server/db.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP — used to email contact form submissions
# Works with Gmail (App Password), Zoho, SendGrid SMTP, Mailgun SMTP,
# Amazon SES SMTP, or your hosting provider's SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LiVEUO Website <info@liveuo.com>
CONTACT_TO_EMAIL=info@liveuo.com

# Google reCAPTCHA v2 (checkbox) — get keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Daily blog indexing (scripts/ping-indexers.js) ---
# These are only needed by the GitHub Actions daily-blog workflow, where they
# are stored as repository secrets rather than in this file.

# Google Indexing API service-account JSON, as a single line. The service
# account must be added as an OWNER of the property in Search Console.
GOOGLE_INDEXING_CREDENTIALS=

# IndexNow key (Bing, Yandex, Naver, Seznam). Must match the <key>.txt file
# served at the site root.
INDEXNOW_KEY=

# Plesk Git deploy webhook. Committing to main does not put a post on the
# site - the IIS host serves its own clone that only updates when Plesk pulls.
# The workflow POSTs to this URL after pushing, then polls the post URL until
# it returns 200. Copy it from Plesk > Websites & Domains > Git > the
# repository > "Webhook URL". Treat it as a secret: anyone holding it can
# trigger a deploy.
PLESK_DEPLOY_WEBHOOK=
